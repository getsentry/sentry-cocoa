// Opt in with xcodebuild test -xcconfig <path>; never include this in consumer builds.
// Package schemes do not inherit Sources/Configuration/SDK.xcconfig.
// See develop-docs/TEST.md for intentional DEBUG and library-evolution differences.

SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES

// Match the applicable Clang diagnostics in SDK.xcconfig.
CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING = YES
CLANG_WARN_COMMA = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_EMPTY_BODY = YES
CLANG_WARN_INFINITE_RECURSION = YES
CLANG_WARN_INT_CONVERSION = YES
CLANG_WARN_NON_LITERAL_NULL_CONVERSION = YES
CLANG_WARN_STRICT_PROTOTYPES = YES
CLANG_WARN_UNREACHABLE_CODE = YES
GCC_TREAT_INCOMPATIBLE_POINTER_TYPE_WARNINGS_AS_ERRORS = YES
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
GCC_WARN_UNINITIALIZED_AUTOS = YES_AGGRESSIVE
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES
CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS = YES
CLANG_WARN_DIRECT_OBJC_ISA_USAGE = YES_ERROR
CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF = YES
CLANG_WARN_OBJC_LITERAL_CONVERSION = YES
CLANG_WARN_OBJC_ROOT_CLASS = YES_ERROR
CLANG_WARN_RANGE_LOOP_ANALYSIS = YES
CLANG_WARN_SUSPICIOUS_MOVE = YES
CLANG_WARN__DUPLICATE_METHOD_MATCH = YES
GCC_WARN_UNDECLARED_SELECTOR = YES

// Mirror the additional diagnostics on the project's SDK and test-utility targets.
SENTRY_PACKAGE_CONVERSION_WARNINGS_SentryObjCInternal = YES
SENTRY_PACKAGE_CONVERSION_WARNINGS_SentryTestUtilsObjCpp = YES
CLANG_WARN_BOOL_CONVERSION = $(SENTRY_PACKAGE_CONVERSION_WARNINGS_$(TARGET_NAME))
CLANG_WARN_CONSTANT_CONVERSION = $(SENTRY_PACKAGE_CONVERSION_WARNINGS_$(TARGET_NAME))
CLANG_WARN_ENUM_CONVERSION = $(SENTRY_PACKAGE_CONVERSION_WARNINGS_$(TARGET_NAME))

SENTRY_PACKAGE_SDK_WARNINGS_SentryObjCInternal = YES
SENTRY_PACKAGE_SDK_WARNINGS_SentryTestUtilsObjCpp = NO
CLANG_WARN_FLOAT_CONVERSION = $(SENTRY_PACKAGE_SDK_WARNINGS_$(TARGET_NAME))
GCC_WARN_SHADOW = $(SENTRY_PACKAGE_SDK_WARNINGS_$(TARGET_NAME))
SENTRY_PACKAGE_OTHER_CFLAGS_SentryObjCInternal = -Wnullable-to-nonnull-conversion -Wnullability-completeness
SENTRY_PACKAGE_OTHER_CFLAGS_SentryTestUtilsObjCpp = -Wall -Wextra
OTHER_CFLAGS = $(inherited) $(SENTRY_PACKAGE_OTHER_CFLAGS_$(TARGET_NAME))

// Xcode enables these features only on the Swift wrappers and their tests.
// Do not change isolation/inference in the SDK, test utilities, or KSCrash.
// Older Xcodes ignore settings for features they do not support.
SENTRY_PACKAGE_SWIFT_FEATURES_SentryObjCCompat = YES
SENTRY_PACKAGE_SWIFT_FEATURES_SentryObjCCompatTests = YES
SWIFT_APPROACHABLE_CONCURRENCY = $(SENTRY_PACKAGE_SWIFT_FEATURES_$(TARGET_NAME))
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = $(SENTRY_PACKAGE_SWIFT_FEATURES_$(TARGET_NAME))
