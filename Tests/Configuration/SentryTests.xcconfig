#include "../../Sources/Configuration/DeploymentTargets.xcconfig"

// (originally added to Sentry.xcconfig in #3716, but it's only needed in the test targets, not the SDK target)
// This config is required so the test code can access the SentryPrivate module. Removing this setting
// leads to an error: no such module '_SentryPrivate' when including the XCFramework
HEADER_SEARCH_PATHS = $(SRCROOT)/Sources/Sentry/include/**

PRODUCT_NAME = Tests
INFOPLIST_FILE = Tests/SentryTests/Info.plist
PRODUCT_BUNDLE_IDENTIFIER = io.sentry.Sentry.tests
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_MODULES = YES
OTHER_CFLAGS = -Wall -Wextra

// SentryTestUtils is shared by the V9 and V10 test targets. It declares dependencies on
// both SDK variants; include only the variant selected by the active configuration.
SENTRY_TEST_UTILS_EXCLUDED_DEPENDENCIES_Debug = Sentry+KSCrash
SENTRY_TEST_UTILS_EXCLUDED_DEPENDENCIES_DebugV10 = Sentry
SENTRY_TEST_UTILS_EXCLUDED_DEPENDENCIES_DebugWithoutUIKit = Sentry+KSCrash
SENTRY_TEST_UTILS_EXCLUDED_DEPENDENCIES_Test = Sentry+KSCrash
SENTRY_TEST_UTILS_EXCLUDED_DEPENDENCIES_TestV10 = Sentry
SENTRY_TEST_UTILS_EXCLUDED_DEPENDENCIES_TestCI = Sentry+KSCrash
SENTRY_TEST_UTILS_EXCLUDED_DEPENDENCIES_Release = Sentry+KSCrash
SENTRY_TEST_UTILS_EXCLUDED_DEPENDENCIES_ReleaseV10 = Sentry
SENTRY_TEST_UTILS_EXCLUDED_DEPENDENCIES_ReleaseWithoutUIKit = Sentry+KSCrash
EXCLUDED_EXPLICIT_TARGET_DEPENDENCIES_SentryTestUtils = $(SENTRY_TEST_UTILS_EXCLUDED_DEPENDENCIES_$(CONFIGURATION))
EXCLUDED_EXPLICIT_TARGET_DEPENDENCIES = $(EXCLUDED_EXPLICIT_TARGET_DEPENDENCIES_$(TARGET_NAME))
