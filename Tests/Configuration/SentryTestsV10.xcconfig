#include "SentryTests.xcconfig"

SENTRY_TEST_UTILS_TARGET = SentryTestUtilsV10

// Temporary expectations selected by this marker map to acceptance IDs in
// SENTRYCRASH_V10_MIGRATION_LEDGER.md. SDK_V10 selects permanent backend-specific tests.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) SDK_V10 SENTRY_DISABLE_SENTRYCRASH_V10 SENTRY_TEST
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) SDK_V10=1 SENTRY_DISABLE_SENTRYCRASH_V10=1 SENTRY_TEST=1
IMPLICIT_DEPENDENCY_DOMAIN = SentryV10

// Tests for implementations removed from the V10 build cannot be linked into this target. Keep
// tests for the low-level tools that remain shared by reporter-neutral SDK features.
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) $(SRCROOT)/Tests/SentryTests/Integrations/SentryCrash/* $(SRCROOT)/Tests/SentryTests/ObjC/Integrations/SentryCrash/* $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/Container+DeepSearch_Tests.m $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/RFC3339UTFString_Tests.m $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashBinaryImageCache* $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashCachedData* $(SRCROOT)/Tests/SentryTests/ObjCpp/SentryCrash/SentryCrashCxaThrowSwapper* $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashDebug_Tests.m $(SRCROOT)/Tests/SentryTests/SentryCrash/SentryCrashDoctorTests.swift $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashDynamicLinker* $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashFileUtils_Tests.m $(SRCROOT)/Tests/SentryTests/SentryCrash/SentryCrashInstallation* $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashJSONCodec_Tests.m $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashMach-OTests.m $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashMach_Tests.m $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashMonitor_* $(SRCROOT)/Tests/SentryTests/ObjCpp/SentryCrash/SentryCrashMonitor_* $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashNSErrorUtilTests.m $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashObjC_Tests.m $(SRCROOT)/Tests/SentryTests/SentryCrash/SentryCrashReport* $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashReport* $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashSignalInfo_Tests.m $(SRCROOT)/Tests/SentryTests/SentryCrash/SentryCrashStackCursorSelfThreadTests.swift $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashString_Tests.m $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashSysCtl_Tests.m $(SRCROOT)/Tests/SentryTests/ObjC/SentryCrash/SentryCrashTests.m $(SRCROOT)/Tests/SentryTests/Integrations/Session/SentrySessionGeneratorTests.swift $(SRCROOT)/Tests/SentryTests/SentryCrashExceptionApplicationTests.swift $(SRCROOT)/Tests/SentryTests/Recording/SentryCrashCTests.swift
