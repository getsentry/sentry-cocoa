#include "Sentry.xcconfig"

// This target provides the KSCrash-backed SDK used by all V10 configurations.
GCC_PREPROCESSOR_DEFINITIONS = $(GCC_PREPROCESSOR_DEFINITIONS_$(CONFIGURATION)) SDK_V10=1
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(SWIFT_ACTIVE_COMPILATION_CONDITIONS_$(CONFIGURATION)) SDK_V10
IMPLICIT_DEPENDENCY_DOMAIN = SentryV10

// The KSCrash variant must still build Sentry.framework because Clang framework
// module lookup and the public umbrella header both expect the Sentry bundle name.
PRODUCT_NAME = $(PRODUCT_MODULE_NAME)

// Sentry.xcconfig excludes KSCrash sources from the plain Sentry target.
// This target owns those files, so clear the exclusion.
EXCLUDED_SOURCE_FILE_NAMES =

// Add Sources/Sentry/Public to header search paths so that _SentryPrivate module compilation
// can find SentryProfilingConditionals.h (a public header not under include/).
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/Sources/Sentry/Public

// Dynamic framework — keeps Sentry+KSCrash consistent with the rest of the SDK xcframework
// builds. Declared here rather than as a global xcodebuild command-line override so it does
// NOT propagate to KSCrash SPM package sub-targets (which have their own product types).
MACH_O_TYPE = mh_dylib

// There is a 'bug' in Xcode that doesn't build arm64e slices for SPM depedendencies
// regardless of the Xcode settings. This can somewhat be worked around
// by setting iOSPackagesShouldBuildARM64e to true in the workspace settings
// however that only applies to iOS, macOS, and visionOS
// see https://github.com/getsentry/sentry-cocoa/pull/8426 for more context
ARCHS[sdk=appletvos*] = $(ARCHS_STANDARD)
ARCHS[sdk=watchos*] = $(ARCHS_STANDARD)

// Mac Catalyst is not affected by iOSPackagesShouldBuildARM64e, so KSCrash SPM packages
// never produce arm64e slices for maccatalyst. Mac Catalyst also doesn't have
// it's own SDK name, we so we need to do some working around to use the one
// build setting that shows Mac Catalyst is being build for: IS_MACCATALYST.
// Key off it via nested macro substitution instead.
SENTRY_KSCRASH_ARM64E_IF_NOT_CATALYST_YES =
SENTRY_KSCRASH_ARM64E_IF_NOT_CATALYST_NO = arm64e
ARCHS[sdk=macosx*] = arm64 x86_64 $(SENTRY_KSCRASH_ARM64E_IF_NOT_CATALYST_$(IS_MACCATALYST))
