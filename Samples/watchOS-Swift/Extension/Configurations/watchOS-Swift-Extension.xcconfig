#include "../../../Shared/Config/_Common.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = io.sentry.watchOS-Swift.watchkitapp.watchkitextension
INFOPLIST_FILE = Extension/Configurations/Info.plist
CODE_SIGN_ENTITLEMENTS = Extension/Configurations/watchOS-Swift-Extension.entitlements

SUPPORTED_PLATFORMS = watchos watchsimulator
SDKROOT = watchos
TARGETED_DEVICE_FAMILY = 4
DEVELOPMENT_ASSET_PATHS = "Extension/Resources/Preview Content"

// These assets belong to the containing watch app; this extension does not provide them.
ASSETCATALOG_COMPILER_APPICON_NAME =
ASSETCATALOG_COMPILER_COMPLICATION_NAME =
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME =
